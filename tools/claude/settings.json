{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/usage-guard.js\"",
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/usage-guard.js\"",
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline/usage-pace.js\"",
    "padding": 0
  },
  "enabledPlugins": {
    "engineering@synced": false,
    "cowork-plugin-management@synced": false,
    "productivity@synced": false,
    "modern-web-guidance@synced": false,
    "chrome-extension-builder@synced": false,
    "10x-Team@synced": false,
    "desktop-commander@synced": false,
    "claude-bridge@synced": false,
    "design@synced": false,
    "data@synced": false
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "advisorModel": "fable",
  "askUserQuestionTimeout": "60s",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "*"
    ]
  },
  "skillOverrides": {
    "agents-md-improver": "name-only",
    "analyze": "name-only",
    "api-and-interface-design": "name-only",
    "architecture": "name-only",
    "brainstorming": "name-only",
    "budget-run": "name-only",
    "build-dashboard": "name-only",
    "code-review": "name-only",
    "code-simplification": "name-only",
    "codebase-design": "name-only",
    "competitive-brief": "name-only",
    "compound": "name-only",
    "context-engineering": "name-only",
    "customer-research": "name-only",
    "data-context-extractor": "name-only",
    "data-visualization": "name-only",
    "deploy-checklist": "name-only",
    "deprecation-and-migration": "name-only",
    "documentation": "name-only",
    "domain-modeling": "name-only",
    "draft-response": "name-only",
    "explore-data": "name-only",
    "file-conversion": "name-only",
    "grilling": "name-only",
    "idea-refine": "name-only",
    "incident-response": "name-only",
    "interview-me": "name-only",
    "kb-article": "name-only",
    "memory-management": "name-only",
    "metrics-review": "name-only",
    "observability-and-instrumentation": "name-only",
    "optimize-prompt": "name-only",
    "performance-optimization": "name-only",
    "planning-and-task-breakdown": "name-only",
    "pr": "name-only",
    "product-brainstorming": "name-only",
    "prototype": "name-only",
    "qa": "name-only",
    "read-jira-xml": "name-only",
    "research": "name-only",
    "resolving-merge-conflicts": "name-only",
